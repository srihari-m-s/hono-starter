# ── Server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ── Auth ────────────────────────────────────────────────────────────────
# Cookie name that holds the JWT after login
AUTH_COOKIE=starter_auth
# Generate a strong secret with:
#   bun -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=change-me-to-a-random-secret
# JWT expiry in hours
AUTH_TOKEN_EXPIRY=1

# ── Database (PostgreSQL) ───────────────────────────────────────────────
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hono_starter
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
# The test suite uses a separate database (hono_starter_test); its connection
# settings are defined in tests/setup.ts, not here.

# ── Email (optional, mailer is currently disabled in code) ──────────────
# GMAIL_USER=
# GMAIL_APP_PASSWORD=