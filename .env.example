# ── Server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Public origin of this API. Used to build links in emails and to validate
# the Origin header on state-changing requests.
APP_URL=http://localhost:8080

# Extra origins allowed to send credentialed cross-origin requests
# (comma-separated). APP_URL is always allowed. These origins get CORS headers
# with credentials, and are the only ones accepted by the Origin check on
# state-changing requests. Example:
#   ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
ALLOWED_ORIGINS=

# Number of reverse proxies in front of the app that append to
# X-Forwarded-For. Leave at 0 when running the app directly (the default) so the
# client address comes from the socket and cannot be spoofed. Set to the real
# number of proxies you run, otherwise callers can pick their own
# rate-limit bucket.
TRUST_PROXY_HOPS=0

# ── Auth / sessions ────────────────────────────────────────────────────
# Cookie that holds the opaque session id
AUTH_COOKIE=starter_session
# How long a session stays valid, in hours (default 7 days)
SESSION_TTL_HOURS=168

# Lifetime of one-time email tokens
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Brute-force protection on auth endpoints (per IP, sliding window)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Password screening. A bundled list of common passwords is always checked.
# Set to "hibp" to additionally screen against Have I Been Pwned's Pwned
# Passwords API (no key required; only a hash prefix is sent).
PASSWORD_BREACH_LOOKUP=off

# ── Email ──────────────────────────────────────────────────────────────
# console -> log the email to stdout (default, works with no provider)
# memory  -> capture emails in-process (used by the test suite)
# smtp    -> deliver over SMTP; requires SMTP_HOST below
MAIL_TRANSPORT=console
MAIL_FROM=Hono Starter <no-reply@example.com>

# Any SMTP provider works: Gmail app passwords, Resend, Brevo, Mailgun,
# SES, Postal, or the local Mailpit catcher from docker-compose.yml.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# ── Database (PostgreSQL) ───────────────────────────────────────────────
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hono_starter
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
# The test suite uses a separate database (hono_starter_test); its connection
# settings are defined in tests/setup.ts, not here.
